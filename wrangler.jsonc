{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capture-map-studio",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "build": {
    "command": "npm run build"
  },
  "previews": {},
  "main": "src/worker.js"
}
